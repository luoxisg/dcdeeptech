{
  "name": "dfplan-firebase-backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "firebase emulators:exec --project demo-dfplan --only firestore 'node --test tests/rules.test.mjs'",
    "bootstrap": "node scripts/bootstrap.mjs",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "test:deploy": "node --test tests/cloud-deploy.test.mjs",
    "test:links": "node --test tests/link-client.test.mjs",
    "test:modules": "node --test tests/modules.test.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.5.1",
    "@google-cloud/firestore": "9.4.1",
    "google-auth-library": "11.3.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "firebase": "13.3.0",
    "firebase-tools": "15.36.0"
  }
}
