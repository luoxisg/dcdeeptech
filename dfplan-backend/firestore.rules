rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function email() { return request.auth.token.email.lower(); }
    function admin() {
      return googleUser()
        && exists(/databases/$(database)/documents/dfplanAdmins/$(email()))
        && get(/databases/$(database)/documents/dfplanAdmins/$(email())).data.active == true
        && get(/databases/$(database)/documents/dfplanAdmins/$(email())).data.role in ['owner','admin'];
    }
    function anonymousUser() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }
    function guest(project) {
      let member = get(/databases/$(database)/documents/dfplanGuests/$(request.auth.uid)).data;
      let invitation = get(/databases/$(database)/documents/dfplanInvites/$(member.inviteId)).data;
      return anonymousUser() && member.active == true && member.role == 'editor'
        && member.projectKey == project && invitation.active == true
        && invitation.claimedBy == request.auth.uid && invitation.projectKey == project
        && invitation.role == 'editor';
    }
    function access(project) { return admin() || (anonymousUser() && guest(project)); }
    // Directory capability is owner-controlled on the invitation, never a name.
    function peopleManager(project) {
      let member = get(/databases/$(database)/documents/dfplanGuests/$(request.auth.uid)).data;
      return guest(project)
        && get(/databases/$(database)/documents/dfplanInvites/$(member.inviteId)).data.get('canManagePeople', false) == true;
    }
    function actorEmail() { return googleUser() ? request.auth.token.email : ''; }
    function actorName() {
      return googleUser()
        ? get(/databases/$(database)/documents/dfplanAdmins/$(email())).data.displayName
        : get(/databases/$(database)/documents/dfplanGuests/$(request.auth.uid)).data.displayName;
    }
    function redeemable(invitation) {
      return invitation.active == true && invitation.claimedBy == ''
        && invitation.expiresAt > request.time && invitation.projectKey == 'wu-family'
        && invitation.role == 'editor';
    }
    function initialOwnerClaim(address) {
      return googleUser() && email() == '__DFPLAN_INITIAL_OWNER_EMAIL__'
        && address == email() && !exists(/databases/$(database)/documents/dfplanAdmins/$(address))
        && request.resource.data.keys().hasOnly(['email','displayName','role','active','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.email == address && request.resource.data.role == 'owner'
        && request.resource.data.active == true
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
    }
    function owner() {
      return admin() && get(/databases/$(database)/documents/dfplanAdmins/$(email())).data.role == 'owner';
    }
    function text(value) { return value is string && value.size() <= 12000; }
    function validDate(value) {
      return value is string && (value == '' || (value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(value.split('-')[0]),int(value.split('-')[1]),int(value.split('-')[2])) is timestamp));
    }
    function validTask(t, id) {
      return t.keys().hasAll(['id','title','priority','owner','collaborators','action','deliverable','dependency','weekStart','weekEnd','status','due','completed','next','evidence','accepted','updatedAt'])
        && t.keys().hasOnly(['id','title','titleEn','priority','owner','ownerEn','assignee','assigneeId','collaborators','collaboratorsEn','action','actionEn','deliverable','deliverableEn','dependency','dependencyEn','weekStart','weekEnd','status','due','completed','next','evidence','accepted','updatedAt','reviewer','backup','claimedOn','effort','blockers','outcomes','recovery'])
        && t.id == id && id.matches('^[A-Za-z0-9_-]{1,80}$')
        && text(t.title) && t.title.size() > 0 && t.title.matches('(?s).*[^\\s].*')
        && t.get('assignee','') is string && t.get('assignee','').size() <= 120
        && t.get('assigneeId','') is string && t.get('assigneeId','').matches('^([a-f0-9]{64})?$')
        && text(t.owner) && text(t.collaborators) && text(t.action) && text(t.deliverable)
        && text(t.dependency) && text(t.next) && text(t.evidence) && text(t.updatedAt)
        && text(t.get('titleEn','')) && text(t.get('ownerEn','')) && text(t.get('collaboratorsEn',''))
        && text(t.get('actionEn','')) && text(t.get('deliverableEn','')) && text(t.get('dependencyEn',''))
        && t.get('reviewer','') is string && t.get('reviewer','').size() <= 120
        && t.get('backup','') is string && t.get('backup','').size() <= 120
        && validDate(t.get('claimedOn',''))
        && t.get('effort','') is string && t.get('effort','').size() <= 500
        && text(t.get('blockers','')) && text(t.get('outcomes','')) && text(t.get('recovery',''))
        && t.priority in ['P0','P1','P2']
        && t.weekStart is int && t.weekEnd is int
        && t.weekStart >= 1 && t.weekEnd >= t.weekStart && t.weekEnd <= 104
        && t.status in ['待核实','未开始','进行中','待家族确认','受阻','已完成']
        && validDate(t.due) && validDate(t.completed) && t.accepted is bool
        && (t.status != '已完成' || (t.accepted == true && t.evidence.size() > 0 && t.evidence.matches('(?s).*[^\\s].*') && t.completed != ''));
    }
    function regularCommit(project, revision) {
      let before = get(/databases/$(database)/documents/dfplanProjects/$(project)).data;
      let after = getAfter(/databases/$(database)/documents/dfplanProjects/$(project)).data;
      let audit = getAfter(/databases/$(database)/documents/dfplanProjects/$(project)/history/$(string(revision))).data;
      return revision is int && revision == before.revision + 1 && revision == after.revision
        && after.updatedBy == request.auth.uid && after.updatedAt == request.time
        && audit.revision == revision && audit.actorUid == request.auth.uid && audit.createdAt == request.time;
    }
    function initialCommit(project, revision) {
      let after = getAfter(/databases/$(database)/documents/dfplanProjects/$(project)).data;
      let audit = getAfter(/databases/$(database)/documents/dfplanProjects/$(project)/history/0).data;
      return project == 'wu-family' && owner() && revision == 0 && after.revision == 0
        && after.startDate == '' && after.updatedBy == request.auth.uid && after.updatedAt == request.time
        && audit.revision == 0 && audit.actorUid == request.auth.uid && audit.createdAt == request.time;
    }
    function consistentCommit(project, revision) {
      return exists(/databases/$(database)/documents/dfplanProjects/$(project))
        ? regularCommit(project, revision) : initialCommit(project, revision);
    }
    function validAssignment(project, task, original) {
      let name = task.get('assignee','');
      let person = task.get('assigneeId','');
      return (name == original.get('assignee','') && person == original.get('assigneeId',''))
        || (name == '' && person == '')
        || (person.matches('^[a-f0-9]{64}$')
          && exists(/databases/$(database)/documents/dfplanProjects/$(project)/people/$(person))
          && get(/databases/$(database)/documents/dfplanProjects/$(project)/people/$(person)).data.active == true
          && get(/databases/$(database)/documents/dfplanProjects/$(project)/people/$(person)).data.displayName == name);
    }
    function taskWrite(project, id) {
      return access(project)
        && request.resource.data.keys().hasOnly(['task','revision','updatedAt','updatedBy'])
        && validTask(request.resource.data.task,id)
        && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time
        && consistentCommit(project,request.resource.data.revision);
    }
    match /dfplanAdmins/{address} {
      allow get: if googleUser() && (address == email() || admin());
      allow list: if admin();
      allow create: if initialOwnerClaim(address) || (admin()
        && address == request.resource.data.email
        && address == address.lower() && address.matches('^[^/@ ]+@[^/@ ]+[.][^/@ ]+$')
        && request.resource.data.keys().hasOnly(['email','displayName','role','active','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.role == 'admin' && request.resource.data.active == true
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid);
      allow update: if admin() && resource.data.role == 'admin'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','active','updatedAt','updatedBy'])
        && request.resource.data.active is bool
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }
    match /dfplanInvites/{invite} {
      allow get: if owner() || (anonymousUser()
        && (resource.data.claimedBy == request.auth.uid || redeemable(resource.data)));
      allow list: if owner();
      allow create: if owner() && invite.matches('^[A-Za-z0-9_-]{43}$')
        && request.resource.data.keys().hasOnly(['displayName','projectKey','role','active','expiresAt','claimedBy','createdAt','createdBy','updatedAt','updatedBy','canManagePeople'])
        && request.resource.data.get('canManagePeople', false) is bool
        && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120
        && request.resource.data.projectKey == 'wu-family' && request.resource.data.role == 'editor'
        && request.resource.data.active == true && request.resource.data.claimedBy == ''
        && request.resource.data.expiresAt is timestamp && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(7,'d')
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
      allow update: if (owner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','canManagePeople','updatedAt','updatedBy'])
        && request.resource.data.get('canManagePeople', false) is bool
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid)
        || (anonymousUser() && redeemable(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy','updatedAt','updatedBy'])
          && request.resource.data.claimedBy == request.auth.uid
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/dfplanGuests/$(request.auth.uid)).data.inviteId == invite
          && getAfter(/databases/$(database)/documents/dfplanGuests/$(request.auth.uid)).data.createdAt == request.time);
      allow delete: if false;
    }
    match /dfplanGuests/{uid} {
      allow get: if owner() || (anonymousUser() && request.auth.uid == uid);
      allow list: if owner();
      allow create: if anonymousUser() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['uid','displayName','projectKey','role','active','inviteId','createdAt','createdBy','updatedAt','updatedBy'])
        && request.resource.data.uid == uid && request.resource.data.role == 'editor' && request.resource.data.active == true
        && request.resource.data.projectKey == 'wu-family'
        && request.resource.data.inviteId is string && request.resource.data.inviteId.matches('^[A-Za-z0-9_-]{43}$')
        && redeemable(get(/databases/$(database)/documents/dfplanInvites/$(request.resource.data.inviteId)).data)
        && request.resource.data.displayName == get(/databases/$(database)/documents/dfplanInvites/$(request.resource.data.inviteId)).data.displayName
        && getAfter(/databases/$(database)/documents/dfplanInvites/$(request.resource.data.inviteId)).data.claimedBy == uid
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == uid && request.resource.data.updatedBy == uid;
      allow update,delete: if false;
    }
    match /dfplanProjects/{project} {
      allow get: if access(project);
      allow list,delete: if false;
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['startDate','revision','updatedAt','updatedBy'])
        && consistentCommit(project,request.resource.data.revision);
      allow update: if access(project)
        && request.resource.data.keys().hasOnly(['startDate','revision','updatedAt','updatedBy'])
        && validDate(request.resource.data.startDate)
        && consistentCommit(project,request.resource.data.revision);
      // Prices are independent of task records and restricted to Google admins.
      function validPrice(p) {
        return p.keys().hasOnly(['currency','rates','revision','reason','updatedAt','updatedBy'])
          && p.currency == 'SGD' && p.revision is int && p.revision > 0
          && p.reason is string && p.reason.size() > 0 && p.reason.size() <= 500
          && p.updatedAt == request.time && p.updatedBy == request.auth.uid
          && p.rates is map && p.rates.keys().hasOnly(['page','photo','audioMinute','videoMinute','setup','minimum'])
          && validRate(p.rates.page) && validRate(p.rates.photo) && validRate(p.rates.audioMinute)
          && validRate(p.rates.videoMinute) && validRate(p.rates.setup) && validRate(p.rates.minimum);
      }
      function validRate(value) { return value is int && value >= 0 && value <= 100000000; }
      match /settings/digitizationPricing {
        allow get: if access(project) && project == 'wu-family';
        allow create,update: if admin() && project == 'wu-family' && validPrice(request.resource.data)
          && request.resource.data.revision == (resource == null ? 1 : resource.data.revision + 1)
          && getAfter(/databases/$(database)/documents/dfplanProjects/$(project)/settings/digitizationPricing/versions/$(string(request.resource.data.revision))).data == request.resource.data;
        allow delete: if false;
        match /versions/{revision} {
          allow read: if access(project) && project == 'wu-family';
          allow create: if admin() && project == 'wu-family' && validPrice(request.resource.data)
            && revision == string(request.resource.data.revision)
            && getAfter(/databases/$(database)/documents/dfplanProjects/$(project)/settings/digitizationPricing).data == request.resource.data
            && request.resource.data.revision == (exists(/databases/$(database)/documents/dfplanProjects/$(project)/settings/digitizationPricing)
              ? get(/databases/$(database)/documents/dfplanProjects/$(project)/settings/digitizationPricing).data.revision + 1 : 1);
          allow update,delete: if false;
        }
      }
      // END UNIT PRICING
      match /people/{person} {
        allow read: if access(project);
        allow create: if (admin() || (anonymousUser() && peopleManager(project))) && project == 'wu-family'
          && person.matches('^[a-f0-9]{64}$')
          && request.resource.data.keys().hasOnly(['displayName','nameKey','responsibility','active','createdAt','createdBy','updatedAt','updatedBy'])
          && request.resource.data.displayName is string && request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 120
          && request.resource.data.displayName.matches('(?s).*[^\\s].*')
          && request.resource.data.nameKey is string && request.resource.data.nameKey.size() > 0 && request.resource.data.nameKey.size() <= 120
          && request.resource.data.nameKey == request.resource.data.nameKey.lower()
          && request.resource.data.responsibility is string && request.resource.data.responsibility.size() <= 240
          && request.resource.data.active == true
          && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time
          && request.resource.data.createdBy == request.auth.uid && request.resource.data.updatedBy == request.auth.uid;
        allow update: if (admin() || (anonymousUser() && peopleManager(project))) && project == 'wu-family'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active','updatedAt','updatedBy'])
          && request.resource.data.active is bool
          && request.resource.data.updatedAt == request.time && request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }
      match /tasks/{id} {
        allow read: if access(project);
        allow create: if taskWrite(project,id) && validAssignment(project,request.resource.data.task,{});
        // Older clients must not silently discard names introduced by this schema.
        // An intentional clear sends the explicit empty-string value instead.
        allow update: if taskWrite(project,id) && validAssignment(project,request.resource.data.task,resource.data.task)
          && (!resource.data.task.keys().hasAny(['reviewer']) || request.resource.data.task.keys().hasAll(['reviewer']))
          && (!resource.data.task.keys().hasAny(['backup']) || request.resource.data.task.keys().hasAll(['backup']))
          && (!resource.data.task.keys().hasAny(['claimedOn']) || request.resource.data.task.keys().hasAll(['claimedOn']))
          && (!resource.data.task.keys().hasAny(['effort']) || request.resource.data.task.keys().hasAll(['effort']))
          && (!resource.data.task.keys().hasAny(['blockers']) || request.resource.data.task.keys().hasAll(['blockers']))
          && (!resource.data.task.keys().hasAny(['outcomes']) || request.resource.data.task.keys().hasAll(['outcomes']))
          && (!resource.data.task.keys().hasAny(['recovery']) || request.resource.data.task.keys().hasAll(['recovery']))
          && (!resource.data.task.keys().hasAny(['assignee']) || request.resource.data.task.keys().hasAll(['assignee']));
        allow delete: if false;
      }
      match /history/{event} {
        allow read: if access(project);
        allow create: if access(project)
          && request.resource.data.keys().hasOnly(['revision','text','textEn','actor','actorEmail','actorUid','createdAt'])
          && event == string(request.resource.data.revision)
          && text(request.resource.data.text) && text(request.resource.data.textEn)
          && request.resource.data.actor is string && request.resource.data.actor.size() <= 120
          && request.resource.data.actorEmail == actorEmail()
          && request.resource.data.actor == actorName()
          && request.resource.data.actorUid == request.auth.uid && request.resource.data.createdAt == request.time
          && consistentCommit(project,request.resource.data.revision);
        allow update,delete: if false;
      }
    }
    match /{document=**} { allow read,write: if false; }
  }
}
