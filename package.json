{
  "name": "dcdeeptech-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "DCDeepTech AI Infrastructure — monorepo (front / platform-sg / backend-cq / shared)",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev:lead-web": "pnpm --filter @lead-intel/web dev",
    "dev:lead-api": "python -m uvicorn apps.api.app.main:app --reload --host 0.0.0.0 --port 8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.0"
}
