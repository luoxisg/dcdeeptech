# DCDeepTech AI Gateway — Environment Configuration
# Copy to .env and fill in real values. Never commit .env to git.

# ── Service ───────────────────────────────────────────────────────────────────
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080

# ── Backend URLs (internal, never exposed to clients) ─────────────────────────
# Singapore control plane (LiteLLM gateway)
SG_LITELLM_URL=http://localhost:4000

# Chongqing inference plane (vLLM, internal network only)
CQ_VLLM_URL=http://192.168.x.x:8000

# ── Upstream API Key (used by gateway to call LiteLLM/vLLM — NOT given to clients) ──
UPSTREAM_API_KEY=sk-litellm-internal-xxx

# ── Key Store ─────────────────────────────────────────────────────────────────
KEY_DB_PATH=data/keys.db

# ── Config ────────────────────────────────────────────────────────────────────
CONFIG_DIR=config/

# ── Audit ─────────────────────────────────────────────────────────────────────
AUDIT_LOG_DIR=audit_logs/

# ── CORS (tighten in production) ──────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Admin network restriction ─────────────────────────────────────────────────
# Comma-separated CIDRs that may call /admin/* endpoints
# Leave blank to allow all (dev only)
ADMIN_ALLOWED_CIDRS=127.0.0.1/32
