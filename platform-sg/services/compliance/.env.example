# sg-compliance service environment variables
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# Service
SG_COMPLIANCE_HOST=0.0.0.0
SG_COMPLIANCE_PORT=8081

# Database
SG_COMPLIANCE_DB_PATH=data/compliance.db

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# Internal — used by compliance service to call gateway auth for scope validation
SG_GATEWAY_INTERNAL_URL=http://sg-gateway:8080
