# ============================================================
# DCDeepTech AI Gateway — Environment Variables
# Copy to .env and fill in real values before running.
# Never commit .env to version control.
# ============================================================

# --- Gateway identity ---
GATEWAY_API_KEY=your-gateway-api-key-here
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# --- Upstream China-side inference backend ---
# Full base URL, e.g. https://cn-inference.example.com
SOPHNET_API_URL=https://your-china-endpoint

# API key for the upstream backend
SOPHNET_API_KEY=your-upstream-api-key-here

# Auth mode for upstream: "bearer" sends Authorization: Bearer <SOPHNET_API_KEY>
# Use "none" if upstream requires no auth
SOPHNET_AUTH_MODE=bearer

# --- Defaults ---
DEFAULT_MODEL=qwenvl

# Timeout in seconds for upstream requests (increase for long inference jobs)
REQUEST_TIMEOUT=60
